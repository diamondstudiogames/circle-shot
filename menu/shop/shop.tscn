[node name="Shop" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_4yet2")
box_info_text = "Шансы получить предмет определённой редкости:
[outline_size=2][color=#{rare_color}]Редкий[/color][/outline_size] предмет: {rare_chance}%
[outline_size=2][color=#{epic_color}]Эпический[/color][/outline_size] предмет: {epic_chance}%
[outline_size=2][color=#{legendary_color}]Легендарный[/color][/outline_size] предмет: {legendary_chance}%
Когда все предметы какой-то редкости разблокированы, в ящике эта редкость заменяется на \"Повышение шансов\", которое работает следующим образом: шансы на предметы других редкостей растут на {chance_increase}%, а шанс на предмет полученной редкости понижается на сумму процентов, на которые повысились остальные, но не может опуститься ниже 20% от базового шанса полученной редкости. Повышенные шансы сбрасываются при получении любого предмета из этого ящика.
Когда все предметы этого ящика разблокированы, содержимое меняется на монеты, количество которых зависит от полученной редкости при открытии ящика."
box_chance_increase = 7.0
elite_box_chance_rare = 45.0
elite_box_chance_epic = 42.0
elite_box_chance_legendary = 13.0
elite_box_chance_increase = 10.0
cost_equip_epic = 500
cost_equip_legendary = 1600
