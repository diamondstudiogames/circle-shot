[connection signal="pressed" from="VBoxContainer/ScrollContainer/MarginContainer/Actions/CUseSkill/Container/Add" to="." method="add_action_event" binds= [&"c_use_skill"]]
[connection signal="pressed" from="VBoxContainer/ScrollContainer/MarginContainer/Actions/CChat/Container/Add" to="." method="add_action_event" binds= [&"c_chat"]]
[connection signal="pressed" from="VBoxContainer/ScrollContainer/MarginContainer/Actions/CPause/Container/Add" to="." method="add_action_event" binds= [&"c_close_chat"]]
[connection signal="pressed" from="VBoxContainer/Buttons/Discard" to="." method="_on_discard_pressed"]
[connection signal="pressed" from="VBoxContainer/Buttons/Save" to="." method="_on_save_pressed"]
[connection signal="canceled" from="EventSelector" to="." method="_on_event_selector_canceled"]
[connection signal="confirmed" from="EventSelector" to="." method="_on_event_selector_confirmed"]
[connection signal="window_input" from="EventSelector" to="." method="_on_event_selector_window_input"]
