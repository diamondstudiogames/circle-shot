[node name="Advices" type="PanelContainer" unique_id=745098895]
custom_minimum_size = Vector2(640, 128)
size_flags_horizontal = 4
script = ExtResource("1_livx7")
advices = Array[String](["Снежки являются отличным дополнением к оружию ближнего боя.", "Определить место, куда прицеливается снайпер, можно по красной точке.", "Дымовая граната способна тушить огонь.", "Через дымовую завесу нельзя прицеливаться со снайперской винтовки.", "Не знаешь, кто находится за дымовой завесой? Брось туда осколочную гранату, и, возможно, тебе не придётся узнавать.", "Светошумовая граната гораздо слабее ослепляет товарищей.", "Коктейль Молотова очень эффективен в закрытых местностях.", "Ты не можешь нанести урон товарищам, даже если очень хочется.", "Телепортатор позволяет перемещаться за стенки, что может сильно помочь в закрытых местностях.", "Целебное зелье полезнее всего там, где ты не возрождаешься после смерти.", "Алмазная пуля работает с любым оружием.", "Бомба невидимости доставит противнику неприятности в битвах 1 на 1.", "Перекат защищает от любых опасностей, кроме продолжительного урона от эффектов.", "В зависимости от текущего оружия скорость игрока может меняться. Например, ходить с ножом быстрее, чем с пистолетом.", "Чем дольше стреляешь из огнестрельного оружия, тем больше разброс пуль и отдача, так что делай перерывы между стрельбой.", "Разброс снарядов может повышаться во время ходьбы.", "Если во время схватки у тебя закончились патроны в магазине, то быстрее будет переключиться на другое оружие, чем ждать перезарядку.", "Держись за укрытиями, если твоё оружие сейчас перезаряжается.", "Ты можешь прервать перезарядку бросаемого оружия или дробовика, нажав кнопку стрельбы.", "Все гранаты отскакивают от стен, кроме коктейля Молотова.", "Энергетик может помочь повернуть ход игры в сторону твоей команды.", "Не нравится играть тремя пальцами? Ты можешь поменять способ стрельбы в настройках управления.", "Используй Circle Shot Launcher для удобного управления разными версиями игры.", "Следить за новостями о разработке можно в Telegram-канале, найти ссылку можно в Меню > Об игре.", "Некоторые карты имеют уникальный саундтрек.", "Ты можешь поменять расположение кнопок управления в настройках, если вариант по умолчанию тебя не устраивает.", "Ты можешь назначить действиям другие клавиши для своего удобства.", "Если в Командном бою твоя команда лидирует по счёту и осталось мало времени, то лучшим вариантом будет отступление.", "В Захвате флага многое значит распределение ролей среди участников команды.", "Двигайся зигзагом, так в тебя будет сложнее попасть.", "Не нравятся эти советы? Ты можешь скрыть их в настройках.", "В игре есть скрытые предметы, которые можно получить из ящиков.", "Получил новое оружие, навык или скин и хочешь его опробовать? Загляни в Тренировку, там можно заняться этим и много чем ещё.", "Закладка бомбы - событие, в котором ОЧЕНЬ важна командная работа.", "Не заходи в Тренировку в 3 часа ночи!"])

