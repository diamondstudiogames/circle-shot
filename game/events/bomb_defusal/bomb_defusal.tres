[resource]
script = ExtResource("2_1hwfc")
name = "Закладка бомбы"
brief_description = "Заложи бомбу или уничтожь противника!"
description = "Две команды - красная и синяя - играют до определённого количества выигранных раундов. Один из игроков красной команды получает бомбу, которую он должен заложить на одной из зон (А или B).
Цель синей команды - уничтожить врагов, не допустить размещение бомбы за отведённое время или обезвредить её после закладывания.
Цель красной команды - уничтожить врагов за отведённое время или разместить бомбу и дать ей взорваться."
default_player_health = 75
min_players = 4
players_divider = 2
team_event = true
scene_path = "uid://bi0w23hbv2mue"
image_path = "uid://dajxd38rxv22x"
maps = Array[ExtResource("1_xhwgd")]([ExtResource("2_0ehtw")])
