[resource]
script = ExtResource("1_x4pw4")
name = "Королевская битва"
brief_description = "Побеждает последний выживший!"
description = "Цель проста - оказаться последним выжившим. Со временем арена боя сужается из-за дыма, и становится всё теснее и теснее.
Также на карте иногда появляются коробки, которые лечат, восполняют боеприпасы или дают бонусное оружие."
min_players = 3
parameters = Dictionary[String, ExtResource("6_0ox73")]({
"ammo_boxes": SubResource("Resource_0ox73"),
"heal_boxes": SubResource("Resource_racpl"),
"smoke_fill_time": SubResource("Resource_ct00e"),
"weapon_boxes": SubResource("Resource_mvlat")
})
scene_path = "uid://yfpyfv6boyao"
image_path = "uid://nk1w1iu0ambu"
maps = Array[ExtResource("1_4pccw")]([ExtResource("1_j8k4y"), ExtResource("4_2fwnc"), ExtResource("5_7ikd7"), ExtResource("6_racpl")])
metadata/_custom_type_script = "uid://df3h1g4gqr0xh"
