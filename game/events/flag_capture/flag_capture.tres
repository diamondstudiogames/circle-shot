[resource]
script = ExtResource("2_070ub")
name = "Захват флага"
brief_description = "Принеси флаг противника на свою базу!"
description = "У каждой команды есть база с флагом. Цель события - приносить вражеские флаги на свою базу.
Если флаг окажется брошенным на земле, то он вернётся на базу через некоторое время.
Побеждает та команда, которая захватит больше флагов."
default_player_health = 90
min_players = 4
team_event = true
parameters = Dictionary[String, ExtResource("4_0sk4j")]({
"flags_to_win": SubResource("Resource_qbmqf"),
"match_time": SubResource("Resource_bnphn")
})
modifiers = Array[ExtResource("4_qbmqf")]([ExtResource("5_bnphn"), ExtResource("6_4qm6d")])
