[resource]
script = ExtResource("2_sni41")
name = "Дуэль"
brief_description = "Сразись с противником 1 на 1!"
description = "Два игрока пытаются убить друг друга в течении нескольких раундов. Победителем объявляется тот, кто сделает больше убийств.
Каждый раунд оружия, которое можно использовать, меняется:
Нечётные раунды: лёгкое, поддержка и ближнее
Чётные раунды: тяжёлое, поддержка и ближнее
Последний раунд: поддержка и ближнее"
max_players = 2
parameters = Dictionary[String, ExtResource("6_mjm0x")]({
"rounds_to_win": SubResource("Resource_8cpb8"),
"smoke_fill_time": SubResource("Resource_7wsnh"),
"weapon_restrictions": SubResource("Resource_u0ucy")
})
scene_path = "uid://u5a0m6y2qb4l"
image_path = "uid://l44s4pxkj2mk"
maps = Array[ExtResource("1_5npr2")]([ExtResource("2_a3s3w"), ExtResource("3_88dxv"), ExtResource("4_1rrf0"), ExtResource("5_dhh65")])
metadata/_custom_type_script = "uid://df3h1g4gqr0xh"
