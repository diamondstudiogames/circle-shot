text = "Добро пожаловать в Тренировку!"

[node name="Label" type="Label" parent="UI/Guide/PanelContainer/VBoxContainer" index="2"]
custom_minimum_size = Vector2(768, 0)
layout_mode = 2
size_flags_vertical = 1
text = "Здесь ты можешь сражаться в любом окружении, изучать карты из многопользовательской игры, испытывать экипировку и просто развлекаться!

В меню (кнопка в левом нижнем углу) тебя встретят выбор экипировки и карты, а также различные действия с игроком. Здесь можно взять открытые оружия, навыки или скины, а также любую карту из многопользовательской игры. Карту самой тренировки можно редактировать.

В редакторе можно расставлять четыре вида блоков, а также различных врагов. По клику на установленного врага можно изменить его параметры (урон и здоровье). Не забывай сохранять изменения перед выходом из редактора!

Однако помни, что в 3 часа ночи Тренировка не работает!"
autowrap_mode = 2

